/system_image_a          emmc     /dev/block/mapper/system_a                   flags=backup=1;flashimg=1;display="System Image A"
/vendor_image_a          emmc     /dev/block/mapper/vendor_a                   flags=backup=1;flashimg=1;display="Vendor Image A"
/system_image_b          emmc     /dev/block/mapper/system_b                   flags=backup=1;flashimg=1;display="System Image B"
/vendor_image_b          emmc     /dev/block/mapper/vendor_b                   flags=backup=1;flashimg=1;display="Vendor Image B"
/system                  erofs    /dev/block/by-name/system                    flags=display="System";slotselect;backup=0
/boot                    emmc     /dev/block/by-name/boot                      flags=display="Boot";slotselect;backup=1;flashimg=1
/vendor_boot             emmc     /dev/block/by-name/vendor_boot               flags=display="Vendor Boot";slotselect;backup=1;flashimg=1
/dtbo                    emmc     /dev/block/by-name/dtbo                      flags=display="DTBO";slotselect;backup=0
/misc                    emmc     /dev/block/by-name/misc                      flags=display="Misc";backup=0
/metadata                f2fs     /dev/block/by-name/metadata                  flags=display="Metadata";backup=0

/external_sd             auto     /dev/block/mmcblk1p1   /dev/block/mmcblk1    flags=display="External SD-card";storage;wipeingui;backup=1;removable;fsflags="utf8"
/usb_otg                 auto     /dev/block/sda1        /dev/block/sda        flags=display="USB-OTG";storage;backup=1;removable

/spl                     emmc     /dev/block/mmcblk0boot0                      flags=display=spl;backup=1
/spl_bk                  emmc     /dev/block/mmcblk0boot1                      flags=display=spl_bk;backup=1
/uboot                   emmc     /dev/block/by-name/uboot                     flags=display="u-boot";slotselect;backup=1;flashimg=1
/cache                   f2fs     /dev/block/by-name/cache                     flags=display=cache;wipeingui;backup=0
/fbootlogo               emmc     /dev/block/by-name/fbootlogo                 flags=display="Fastboot logo";backup=1;flashimg=1
/logo                    emmc     /dev/block/by-name/logo                      flags=display="Boot logo";backup=1;flashimg=1
